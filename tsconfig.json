
{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["."],
  "exclude": [
    "vite.config.ts",
    "tests/ledger",
    "tests/board-reports",
    "tests/ai-reports",
    "tests/webhookRetrySweep.test.ts",
    "tests/search.test.ts",
    "tests/encryption.test.ts",
    "tests/taxProfile.test.ts",
    "tests/fieldFilter.test.ts",
    "tests/leadEnrichmentService.test.ts",
    "tests/leadEnrichmentScheduler.test.ts",
    "tests/leadEnrichmentRoute.test.ts",
    "tests/webhookSecrets.test.ts",
    "tests/health.test.ts",
    "tests/notificationCombine.test.ts",
    "tests/export.test.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
