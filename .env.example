# ==========================================
# CRM INCODA — Variables de Entorno
# Copia este archivo a .env y ajusta los valores
# ==========================================

# MongoDB (en Docker usa "mongo", en local usa 127.0.0.1)
MONGO_URI=mongodb://mongo:27017/crm_incoda

# Seguridad
# Genera uno seguro con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia_esto_por_un_string_aleatorio_largo
# Cifrado en reposo (TIN/W-9). Debe decodificar a exactamente 32 bytes en base64.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=cambia_esto_por_una_clave_base64_de_32_bytes
# URL del frontend en producción (para CORS)
CORS_ORIGIN=https://crm.incoda.biz
NODE_ENV=production

# ---- Email (Notificaciones) ----
# Para Gmail usa una "App Password" (no tu contraseña normal)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM=CRM INCODA <tu_correo@gmail.com>

# Correo fijo que siempre recibe notificaciones (además de usuarios con rol CRM)
NOTIFY_EMAIL=soporte@ejemplo.com

# ---- Mercury API (sincronización directa de transacciones bancarias) ----
# Token generado en Mercury → Settings → API Tokens (Read Only recomendado)
MERCURY_API_TOKEN=

# ---- Google Calendar OAuth2 (opcional) ----
# Crea credenciales en https://console.cloud.google.com → APIs & Services → Credentials
# Agrega authorized redirect URI: {APP_URL}/api/calendar/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL base del CRM (para el redirect URI de Google)
APP_URL=http://localhost:3001

# ---- AI Lead Scoring (opcional) ----
# Obtén tu key en https://console.anthropic.com/settings/keys
# Sin esta variable el scoring usa heurística automática (no requiere API)
# El modelo usado es claude-haiku-4-5 (rápido y económico para scoring masivo)
ANTHROPIC_API_KEY=

# ---- Seed / Demo Users (solo para primer arranque) ----
# Passwords del seed inicial — leídos SOLO por el servidor, nunca llegan al bundle del cliente
# Cámbialos antes de arrancar en producción
SEED_PASS_ADMIN=cambia_esto
SEED_PASS_CONSULTANT=cambia_esto
SEED_PASS_SALES=cambia_esto

# ---- Google Drive (Service Account) ----
# Crea una Service Account en https://console.cloud.google.com → IAM & Admin → Service Accounts
# 1. Crea cuenta de servicio → descarga el archivo JSON de la clave
# 2. Comparte la carpeta raíz de Drive de la empresa con el email de la service account (Editor)
# 3. Copia la ruta del archivo JSON y el ID de la carpeta raíz abajo
#
# Cómo obtener el FOLDER_ID: abre la carpeta en Drive → copia el ID del URL
# (e.g. https://drive.google.com/drive/folders/1abc123XYZ → ID: 1abc123XYZ)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=
